# Copia aquest fitxer a .env i afegeix .env al .gitignore.
# .env.example SÍ que va al repositori (mostra què cal configurar
# sense filtrar credencials). És un detall que els revisors noten.

POSTGRES_USER=pr3
POSTGRES_PASSWORD=pr3_local_dev
POSTGRES_DB=infraedu

# Des de Windows (productor Python, dbt, Power BI)
PG_HOST_EXTERN=localhost
PG_PORT_EXTERN=5432
KAFKA_BOOTSTRAP_EXTERN=localhost:9092

# Des de dins de la xarxa Docker (jobs de Flink)
KAFKA_BOOTSTRAP_INTERN=kafka:29092

# Topic principal d'esdeveniments
KAFKA_TOPIC=infraedu.events

MLFLOW_TRACKING_URI=sqlite:///mlruns.db
